import self as feed
import json
import value
effect fn main() -> Unit = {
  println(json.stringify(value.object([
    ("id1", value.str(feed.format_id(1))),
    ("id42", value.str(feed.format_id(42))),
    ("parse", value.int(feed.parse_seq("dum-00000042"))),
    ("parse_bad", value.int(feed.parse_seq("xxx"))),
    ("tmpl", value.int(feed.template_index(7, 3))),       // 7%3=1
    ("newer", value.bool(feed.is_newer(5, 3))),
    ("not_newer", value.bool(feed.is_newer(3, 5))),
  ])))
}
